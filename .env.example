# Für lokales `docker compose up`: nach .env kopieren (nicht ins Git einchecken).
# In Portainer trägst du dieselben Namen unter "Environment variables" ein.
DARKROOM_LIBRARY_PATH=/pfad/zu/deinen/fotos
# DARKROOM_DATA_PATH=/pfad/fuer/darkroom-daten
# DARKROOM_PORT=8000
ANTHROPIC_API_KEY=
# DARKROOM_AI_MODEL=claude-sonnet-5-5
# DARKROOM_AI_PROVIDER=ollama
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5-coder:14b
# Mehrere Benutzer: beim ersten Aufruf der Seite wird der Admin angelegt (README, «Mehrere Benutzer»)
# DARKROOM_AUTH=off              # Anmeldung abschalten (ein Benutzer wie früher)
# DARKROOM_USERS_LIBRARY=/library/_users   # Fotoordner weiterer Benutzer (Standard: <Bibliothek>/_users)
